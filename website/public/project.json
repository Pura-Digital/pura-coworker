{
  "schemaVersion": "1.0",
  "name": "Aiden",
  "organization": "Pura Digital S.r.l.",
  "canonicalUrl": "https://github.com/Pura-Digital/pura-coworker",
  "repository": "https://github.com/Pura-Digital/pura-coworker",
  "releases": "https://github.com/Pura-Digital/pura-coworker/releases",
  "license": {
    "name": "Proprietary",
    "summary": "All rights reserved. Not open source."
  },
  "version": "3.5.3",
  "lastReviewed": "2026-10-29",
  "description": "Proprietary AI agent desktop app for Windows and macOS with one-click installation, sandbox isolation, multi-model support, built-in Skills, MCP integration, GUI automation, Pura LLM connect, and remote control.",
  "applicationCategory": "DeveloperApplication",
  "platforms": ["Windows", "macOS"],
  "prebuiltInstallerTypes": {
    "Windows": ".exe",
    "macOS": ".dmg"
  },
  "install": [
    {
      "platform": "macOS",
      "method": "Homebrew",
      "commands": ["brew tap OpenCoworkAI/tap", "brew install --cask --no-quarantine aiden"]
    },
    {
      "platform": "Windows and macOS",
      "method": "GitHub Releases",
      "url": "https://github.com/Pura-Digital/pura-coworker/releases"
    }
  ],
  "capabilities": [
    "Local AI agent desktop workspace",
    "Multi-model provider configuration",
    "Pura LLM subscription connect",
    "Built-in Skills for PPTX, DOCX, XLSX, and PDF workflows",
    "Model Context Protocol tool integration",
    "GUI automation through computer use",
    "Remote control through Feishu (Lark) and Slack",
    "Workspace path restrictions",
    "VM sandbox isolation with WSL2 and Lima when available"
  ],
  "modelProviders": [
    {
      "name": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api",
      "recommendedModels": ["claude-4-5-sonnet"]
    },
    {
      "name": "Anthropic",
      "baseUrl": "default",
      "recommendedModels": ["claude-4-5-sonnet"]
    },
    {
      "name": "Zhipu AI / GLM",
      "baseUrl": "https://open.bigmodel.cn/api/anthropic",
      "recommendedModels": ["glm-4.7", "glm-4.6"]
    },
    {
      "name": "MiniMax",
      "baseUrl": "https://api.minimaxi.com/anthropic",
      "recommendedModels": ["minimax-m2"]
    },
    {
      "name": "Kimi",
      "baseUrl": "https://api.kimi.com/coding/",
      "recommendedModels": ["kimi-k2"]
    }
  ],
  "securityAndPrivacy": {
    "localFirst": true,
    "workspaceBoundary": "File operations are restricted to the selected workspace folder.",
    "vmIsolation": ["WSL2 on Windows", "Lima on macOS"],
    "dataPolicy": "Aiden runs locally; external network traffic goes to the AI model APIs and integrations the user configures."
  },
  "sourcePages": [
    "https://github.com/Pura-Digital/pura-coworker/blob/main/readme.md",
    "https://github.com/Pura-Digital/pura-coworker/blob/main/README_zh.md",
    "https://github.com/Pura-Digital/pura-coworker/blob/main/CHANGELOG.md",
    "https://github.com/Pura-Digital/pura-coworker/blob/main/ROADMAP.md",
    "https://github.com/Pura-Digital/pura-coworker/blob/main/SECURITY.md"
  ]
}
